PORT=5000
NODE_ENV=development

# Database Settings (PostgreSQL)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=copay_psp_analytics

# Microsoft Fabric Settings (Future Integration)
# FABRIC_SERVER=your_fabric_server.datawarehouse.fabric.microsoft.com
# FABRIC_DATABASE=your_fabric_database
# FABRIC_USER=your_entra_user@domain.com
# FABRIC_PASSWORD=your_entra_password

# ML Prediction Service Settings
ML_PROVIDER=mock
ML_SERVICE_URL=

# Python ML Settings (Patient Segmentation)
PYTHON_SEGMENTATION_EXECUTABLE=venv_strategy/Scripts/python.exe
SEGMENTATION_MODEL_DIR=ml_model/segmentation

# Python ML Settings (Strategy Effectiveness)
PYTHON_STRATEGY_EXECUTABLE=venv_strategy/Scripts/python.exe
STRATEGY_MODEL_DIR=ml_model/strategy

# Python ML Settings (Churn Prediction)
PYTHON_CHURN_EXECUTABLE=venv_strategy/Scripts/python.exe
CHURN_MODEL_DIR=ml_model/churn
ML_PROVIDER=python

# JWT Settings
JWT_SECRET=your_jwt_secret_placeholder
JWT_EXPIRES_IN=24h

# SQLite Settings
SQLITE_DB_PATH=src/database/auth.db

# File Upload Settings
UPLOAD_STORAGE_ROOT=./uploads
UPLOAD_UNKNOWN_SHEET_BEHAVIOR=ignore



